# Copy to .env (never commit .env)
DATABASE_URL=sqlite:///./uc1.db
APP_API_KEY=choose-a-local-dev-key
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Pinecone as the vector store. Leave empty to use the local vector search.
# Set SEARCH_BACKEND=pinecone to switch it on.
SEARCH_BACKEND=vector
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=uc1
